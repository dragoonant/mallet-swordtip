{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mallet42k.dev/schemas/card-deck.schema.json",
  "title": "Spearhead card deck (twist and battle tactic cards of one realm battlefield)",
  "type": "object", "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^rbf[.][a-z0-9-]+$" },
    "name": { "type": "string", "maxLength": 60 },
    "sides": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "name": { "type": "string", "maxLength": 60 } },
        "required": ["id", "name"]
      }
    },
    "twists": { "type": "array", "items": { "$ref": "#/$defs/Twist" } },
    "tactics": { "type": "array", "items": { "$ref": "#/$defs/Tactic" } }
  },
  "required": ["id", "name", "sides", "twists", "tactics"],
  "$defs": {
    "Twist": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^card[.]twist[.][a-z0-9-]+$" },
        "side": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "maxLength": 40 },
        "picker": { "enum": ["underdog", "rollOffWinner", "underdogElseRollOff", "underdogElseEach", "none"] },
        "duration": { "enum": ["round", "battle", "immediate"] },
        "text": { "type": "string", "minLength": 10, "maxLength": 600 },
        "flavour": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "side", "name", "picker", "duration", "text"]
    },
    "Tactic": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^card[.]tactic[.][a-z0-9-]+$" },
        "name": { "type": "string", "maxLength": 40 },
        "tactic": {
          "type": "object", "additionalProperties": false,
          "properties": { "text": { "type": "string", "minLength": 10, "maxLength": 400 }, "vp": { "type": "integer", "minimum": 1, "maximum": 3 } },
          "required": ["text", "vp"]
        },
        "command": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "maxLength": 40 },
            "timing": { "type": "string", "maxLength": 80 },
            "text": { "type": "string", "minLength": 10, "maxLength": 400 }
          },
          "required": ["name", "timing", "text"]
        },
        "flavour": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "name", "tactic", "command"]
    }
  }
}

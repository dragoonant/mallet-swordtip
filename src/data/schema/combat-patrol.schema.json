{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mallet42k.dev/schemas/combat-patrol.schema.json",
  "title": "Combat Patrol fixed force / Spearhead army",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "faction": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "name": {
      "type": "string",
      "maxLength": 60
    },
    "detachment": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "optional; Combat Patrol has no detachment rule"
    },
    "armyRule": {
      "$ref": "common.schema.json#/$defs/Id",
      "description": "optional; overrides the faction armyRule for this patrol (a patrol printing an older/different faction ability)"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "datasheet": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "wargear": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "modelId": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "weapons": {
                  "$ref": "common.schema.json#/$defs/IdList"
                }
              },
              "required": [
                "modelId",
                "count",
                "weapons"
              ]
            }
          },
          "patrolSquads": {
            "type": "array",
            "description": "Patrol Squads: the parts this unit splits into at Declare Battle Formations (PlayerSetup.splitUnits); each part is a unit of its own with this wargear",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 1
                },
                "wargear": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "modelId": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]+$"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "weapons": {
                        "$ref": "common.schema.json#/$defs/IdList"
                      }
                    },
                    "required": [
                      "modelId",
                      "count",
                      "weapons"
                    ]
                  }
                }
              },
              "required": [
                "ref",
                "size",
                "wargear"
              ]
            }
          },
          "attachTo": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "enhancement": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "reserve": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ability": {
                "$ref": "common.schema.json#/$defs/Id"
              },
              "via": {
                "$ref": "common.schema.json#/$defs/Id",
                "description": "F18 (core 24.1): the ability that set the unit up in reserve; with the DEPLOY keyword the unit is destroyed at the start of round 4 if still in reserve"
              }
            },
            "required": [
              "ability"
            ],
            "description": "AoS: the unit starts in reserve and arrives through this ability (Ironjawz Ere We Go)"
          },
          "tokens": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "ref",
          "datasheet",
          "size"
        ]
      }
    },
    "unitChoices": {
      "type": "array",
      "description": "Choice groups: exactly one ref of each group is fielded (PlayerSetup.unitChoices); default is used when omitted",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "refs": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "default": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "required": [
          "id",
          "refs",
          "default"
        ]
      }
    },
    "stratagems": {
      "$ref": "common.schema.json#/$defs/IdList"
    },
    "enhancements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "default"
        ]
      }
    },
    "secondaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "text": {
            "$ref": "common.schema.json#/$defs/Text"
          },
          "default": {
            "type": "boolean"
          },
          "scoring": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/ScoringRule"
            }
          }
        },
        "required": [
          "id",
          "name",
          "text",
          "default",
          "scoring"
        ]
      }
    },
    "warlord": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "mode": {
      "const": "spearhead",
      "description": "present = a Spearhead army (SPH-2): 2 regimentAbilities, 4 enhancements, warlord = the general"
    },
    "battleTraits": {
      "$ref": "common.schema.json#/$defs/IdList",
      "description": "ability ids attached to every unit of the army"
    },
    "regimentAbilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "default": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "default"
        ]
      }
    }
  },
  "required": [
    "id",
    "faction",
    "name",
    "units",
    "stratagems",
    "enhancements",
    "secondaries",
    "warlord"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "battleTraits",
          "regimentAbilities"
        ],
        "properties": {
          "regimentAbilities": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2
          },
          "enhancements": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  ]
}
